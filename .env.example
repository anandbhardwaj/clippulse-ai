GROQ_API_KEY=gsk_your_groq_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Netscape-format cookies file for private / login-gated Instagram or YouTube media
YTDLP_COOKIES_FILE=

# LLM used to locate the requested moment: anthropic (default) or gemini
LLM_PROVIDER=anthropic
# Optional model override (defaults: claude-opus-5 for anthropic, gemini-2.5-flash for gemini)
LLM_MODEL=
